# Copy this file to .env and fill in your values. Never commit .env.

# Required: Google Gemini API key, used by the Agent (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional: OpenSky API client, used only by `validate_sources.py --opensky`
# (not needed for the Agent or the web chat). Create an API client on your
# account page at https://opensky-network.org to get these two values.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
